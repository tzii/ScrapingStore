BASE_URL=https://sandbox.oxylabs.io/products
MAX_RETRIES=3
DEFAULT_TIMEOUT=30
RETRY_BACKOFF=0.5
DB_NAME=products.db
# Optional: place generated data/docs somewhere other than the current directory
# SCRAPINGSTORE_HOME=/path/to/workspace
# DATA_DIR=/path/to/data
# DOCS_DIR=/path/to/docs
# Optional: override the User-Agent header sent by the scrapers
# USER_AGENT="MyScraperBot/1.0 (+https://example.com/contact)"
